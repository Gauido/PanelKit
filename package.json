{
  "name": "panelkit-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source visual builder for CRMs and internal tools that exports a real React repo.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @panelkit/editor dev",
    "build": "pnpm --filter @panelkit/editor build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "export:sample": "tsx scripts/export-sample.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "vite": "^8.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0"
  }
}
